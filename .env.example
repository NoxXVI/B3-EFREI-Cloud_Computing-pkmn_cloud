# Copier ce fichier vers .env.local et renseigner les valeurs.
# Ne jamais committer .env.local.

# --- Application -----------------------------------------------------------
# URL publique de l'application (http://localhost:3000 en local).
APP_URL=

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé service role, strictement côté serveur (jamais NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=

# --- Modèle d'IA -----------------------------------------------------------
# Endpoint compatible OpenAI et modèle appelés uniquement côté serveur.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- Upstash Redis (cache et quotas) ---------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Langfuse (observabilité de l'IA) --------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Développement local ---------------------------------------------------
# Hôtes supplémentaires autorisés à ouvrir le serveur de dev (HMR Next.js).
ALLOWED_DEV_ORIGINS=
